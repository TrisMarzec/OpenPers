# Copy to .env and adjust. Never commit the real .env.

# Public URL of your installation (https:// enables secure cookies).
APP_URL=http://localhost:3000

# Required: at least 32 random characters, e.g. `openssl rand -hex 32`.
# Used for sessions and for encrypting confidential employee fields – keep it safe and never change it
# after setup, otherwise encrypted fields can no longer be read.
SECRET_KEY=

# Docker Compose: password of the bundled PostgreSQL database.
POSTGRES_PASSWORD=

# Without Docker: leave DATABASE_URL empty to use the embedded database (PGlite) in DATA_DIR,
# or point it to your own PostgreSQL 14+.
# DATABASE_URL=postgres://openpers:secret@localhost:5432/openpers

# Where the embedded database and uploaded files are stored.
DATA_DIR=./data

PORT=3000
# LOG_LEVEL=info
