{
  "name": "openpers",
  "private": true,
  "version": "0.1.0",
  "license": "AGPL-3.0-only",
  "type": "module",
  "workspaces": ["packages/*", "apps/*"],
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "npm run dev -w @openpers/server & npm run dev -w @openpers/web",
    "build": "npm run build -w @openpers/web && npm run build -w @openpers/server",
    "start": "node apps/server/dist/index.js",
    "test": "npm test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "seed:demo": "npm run seed:demo -w @openpers/server"
  }
}
